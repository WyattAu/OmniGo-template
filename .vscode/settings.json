{
  "go.useLanguageServer": true,
  "go.lintTool": "golangci-lint",
  "go.formatTool": "gofumpt",
  "go.testFlags": [
    "-race"
  ],
  "go.buildFlags": [
    "-mod=readonly"
  ],
  "editor.formatOnSave": true,
  "workbench.colorTheme": "Shroom Space",
  "workbench.iconTheme": "vs-seti",
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  }
}
